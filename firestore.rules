rules_version = '2';

// SomeGoodSki shared vacations. Paste into Firebase console → Firestore Database → Rules → Publish.
// Every write is checked for shape and size, so the database can't be used as general storage.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /vacations/{vid} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // only the expected fields, and nothing big: a real vacation is a few KB
      function validShape(d) {
        return d.keys().hasOnly(['json', 'version', 'members', 'names', 'updatedBy', 'updatedAt', 'joinCode'])
          && d.json is string && d.json.size() <= 300000
          && d.version is int
          && d.members is list && d.members.size() >= 1 && d.members.size() <= 10
          && d.names is map && d.names.size() <= 20
          && d.updatedBy is string && d.updatedBy.size() <= 80
          && (!('joinCode' in d) || (d.joinCode is string && d.joinCode.size() <= 40));
      }
      // you may only write your own display name
      function onlyMyName() {
        return request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.names) || (request.resource.data.names[request.auth.uid] is string && request.resource.data.names[request.auth.uid].size() <= 80));
      }
      function validInvite(code) {
        let path = /databases/$(db)/documents/vacations/$(vid)/invites/$(code);
        return code is string && exists(path) && get(path).data.expiresAt > request.time;
      }
      // saving the vacation must build on the latest version (blocks stale overwrites)
      function isSaving() {
        return changed().hasOnly(['json', 'version', 'updatedBy', 'updatedAt', 'names'])
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.updatedAt == request.time
          && onlyMyName();
      }
      // a member may remove others (never add them; adding goes through invites)
      function isRemovingMembers() {
        return changed().hasOnly(['members'])
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() < resource.data.members.size();
      }
      // joining adds exactly yourself, with a live invite code
      function isJoining() {
        let members = request.resource.data.members;
        return signedIn()
          && changed().hasOnly(['members', 'names', 'joinCode'])
          && members.hasAll(resource.data.members)
          && members.size() == resource.data.members.size() + 1
          && request.auth.uid in members
          && onlyMyName()
          && validInvite(request.resource.data.joinCode);
      }

      allow read: if isMember();
      allow create: if signedIn()
        && validShape(request.resource.data)
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.version == 1
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.updatedAt == request.time
        && !('joinCode' in request.resource.data);
      allow update: if validShape(request.resource.data)
        && ((isMember() && (isSaving() || isRemovingMembers())) || (!isMember() && isJoining()));
      allow delete: if isMember();

      match /invites/{code} {
        function member() {
          return signedIn() && request.auth.uid in get(/databases/$(db)/documents/vacations/$(vid)).data.members;
        }
        function validInviteShape(d) {
          return d.keys().hasOnly(['vacationName', 'winterYear', 'fromName', 'createdBy', 'createdAt', 'expiresAt'])
            && d.vacationName is string && d.vacationName.size() <= 200
            && d.winterYear is int
            && d.fromName is string && d.fromName.size() <= 80
            && d.createdBy == request.auth.uid
            && d.createdAt == request.time
            && d.expiresAt is timestamp
            && d.expiresAt > request.time
            && d.expiresAt <= request.time + duration.value(30, 'd');
        }
        allow get: if signedIn();           // you need the code to read one
        allow list, delete: if member();
        allow create: if member() && code.size() <= 40 && validInviteShape(request.resource.data);
      }
    }
  }
}
