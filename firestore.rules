rules_version = '2';

// SomeGoodSki shared vacations. Paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /vacations/{vid} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      // a change that only touches membership (joining, removing someone, display names)
      function onlyMembership() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'joinCode']);
      }
      function validInvite(code) {
        let path = /databases/$(db)/documents/vacations/$(vid)/invites/$(code);
        return code is string && exists(path) && get(path).data.expiresAt > request.time;
      }
      // joining adds exactly yourself, with a live invite code
      function isJoining() {
        let members = request.resource.data.members;
        return signedIn()
          && onlyMembership()
          && members.hasAll(resource.data.members)
          && members.size() == resource.data.members.size() + 1
          && request.auth.uid in members
          && validInvite(request.resource.data.joinCode);
      }
      // saving the vacation must build on the latest version (blocks stale overwrites)
      function isSaving() {
        return request.resource.data.version == resource.data.version + 1
          && request.resource.data.members == resource.data.members
          && request.resource.data.json is string;
      }

      allow read: if isMember();
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.version == 1
        && request.resource.data.json is string;
      allow update: if (isMember() && (isSaving() || onlyMembership())) || (!isMember() && isJoining());
      allow delete: if isMember();

      match /invites/{code} {
        function member() {
          return signedIn() && request.auth.uid in get(/databases/$(db)/documents/vacations/$(vid)).data.members;
        }
        allow get: if signedIn();           // you need the code to read one
        allow list, create, delete: if member();
      }
    }
  }
}
